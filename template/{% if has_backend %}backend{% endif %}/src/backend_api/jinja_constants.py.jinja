{%- set bind_all_interfaces = (not deploy_as_executable) or (install_as_windows_service and windows_service_bind_policy == 'all_interfaces_only') -%}
{% raw %}APP_NAME = "{% endraw %}{{ repo_name }}{% raw %}"
DEPLOYED_PORT_NUMBER = {% endraw %}{{ backend_deployed_port_number }}{% raw %}
HUMAN_FRIENDLY_APP_NAME = "{% endraw %}{{ human_friendly_app_name }}{% raw %}"
DEFAULT_DEPLOYED_HOST = "{% endraw %}{{ '0.0.0.0"  # noqa: S104 # this is intentionally allowing connections from all hosts' if bind_all_interfaces else '127.0.0.1"' }}{% raw %}{% endraw %}{% if install_as_windows_service %}{% raw %}

# Windows service identity. The registered name is org-prefixed to avoid
# colliding with any other service already on the machine; kept separate from
# APP_NAME (which also names crash dumps, templates, etc.).
WINDOWS_SERVICE_NAME = f"{% endraw %}{{ windows_service_org_prefix }}{% raw %}{APP_NAME}"
WINDOWS_SERVICE_DISPLAY_NAME = f"{% endraw %}{{ installer_manufacturer }}{% raw %} {HUMAN_FRIENDLY_APP_NAME}"{% endraw %}{% endif %}
