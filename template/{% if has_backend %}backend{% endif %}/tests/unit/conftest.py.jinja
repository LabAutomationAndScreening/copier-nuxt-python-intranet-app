class UnexpectedForceExitError(Exception):
    def __init__(self, exit_code: int) -> None:
        super().__init__(
            f"ServerControl force-exit timer fired with exit code {exit_code}: a server stop was requested but never marked complete"
        )


def _refuse_force_exit(server_control: ServerControl) -> None:
    raise UnexpectedForceExitError(server_control.exit_code)


@pytest.fixture(autouse=True, scope="session")
def refuse_unexpected_force_exit():
    # A force-exit timer left running would call os._exit with the requested code (often 0) and end the test run as if it had passed.
    # Raising instead surfaces it as an unhandled thread exception, which pytest.ini turns into a test failure.
    with pytest.MonkeyPatch.context() as monkeypatch:
        monkeypatch.setattr(
            ServerControl,
            ServerControl._force_exit.__name__,  # noqa: SLF001 # the guard intentionally replaces this private method
            _refuse_force_exit,
        )
        yield


def _get_all_state_attributes(app: FastAPI) -> set[str]:
    return set(
        app.state._state.keys()  # noqa: SLF001 # yes this isn't great, but not sure of another way to be able to keep the state from bleeding over between tests. given the implementation it seems unlikely that _state would change in future versions
    )


@pytest.fixture(autouse=True)
def reset_app_state():
    """Reset app state between tests by removing dynamically added attributes."""
    original_attrs = _get_all_state_attributes(app)

    yield

    current_attrs = _get_all_state_attributes(app)
    added_attrs = current_attrs - original_attrs
    for attr in added_attrs:
        delattr(app.state, attr){% endraw %}{% if has_circuit_python_backend_template_been_instantiated %}{% raw %}


