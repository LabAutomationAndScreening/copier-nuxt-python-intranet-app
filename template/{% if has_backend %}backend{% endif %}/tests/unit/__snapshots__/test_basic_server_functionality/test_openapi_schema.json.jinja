{% raw %}{
  "openapi": "3.1.0",
  "info": {
    "title": "{% endraw %}{{ human_friendly_app_name }}{% raw %}",
    "description": "{% endraw %}{{ backend_rest_api_description }}{% raw %}",
    "version": "0.1.0"
  },
  "paths": {
    "/api/healthcheck": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Check API health",
        "operationId": "healthcheck_api_healthcheck_get",
        "parameters": [
          {
            "name": "prependV",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "title": "Prepend V",
              "description": "Include a 'v' before the version number",
              "default": false
            },
            "description": "Include a 'v' before the version number"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthcheckResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/shutdown": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Shut down the server",
{% endraw %}{% if install_as_windows_service %}{% raw %}        "description": "Stop the Windows service cleanly. Windows leaves it stopped; start it again from the Services console or with sc start.",
{% endraw %}{% elif deploy_as_executable %}{% raw %}        "description": "Stop the server cleanly (exit code 0) once this response is sent and shutdown cleanup has finished.\n\nThe server stays stopped unless something external starts it again.",
{% endraw %}{% else %}{% raw %}        "description": "Stop the server cleanly (exit code 0) once this response is sent and shutdown cleanup has finished.\n\nWhether it stays stopped depends on the platform's restart policy:\n\n- docker-compose `restart: on-failure`: stays stopped. This policy also doesn't restart the container when the Docker daemon or host restarts.\n- docker-compose `restart: unless-stopped` / `always`, or Kubernetes/k3s: started again, so this behaves like a restart. To keep it stopped there, scale the deployment to zero or stop the container from the platform.",
{% endraw %}{% endif %}{% raw %}        "operationId": "shutdown_api_shutdown_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShutdownResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/restart": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Restart the server",
{% endraw %}{% if install_as_windows_service %}{% raw %}        "description": "Stop the Windows service and report a failure, so the restart-on-failure recovery configured at install starts it again.",
{% endraw %}{% elif deploy_as_executable %}{% raw %}        "description": "Stop the server with a non-zero exit code once this response is sent and shutdown cleanup has finished.\n\nThe server only comes back if a supervisor (e.g. a process manager or scheduled task) is configured to restart it on failure; otherwise this behaves like a shutdown.",
{% endraw %}{% else %}{% raw %}        "description": "Stop the server with a non-zero exit code once this response is sent and shutdown cleanup has finished.\n\nThe container platform then starts it again and records the exit as a failure. Works with Kubernetes/k3s and docker-compose `restart: on-failure`, `unless-stopped` or `always`. With `restart: no` the server stays stopped.",
{% endraw %}{% endif %}{% raw %}        "operationId": "restart_api_restart_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestartResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }{% endraw %}{% if backend_uses_graphql %}{% raw %},
    "/api/graphql": {
      "get": {
        "tags": [
          "graphql"
        ],
        "summary": "Handle Http Get",
        "operationId": "handle_http_get_api_graphql_get",
        "responses": {
          "200": {
            "description": "The GraphiQL integrated development environment.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Not found if GraphiQL or query via GET are not enabled."
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "graphql"
        ],
        "summary": "Handle Http Post",
        "operationId": "handle_http_post_api_graphql_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }{% endraw %}{% endif %}{% raw %}
  },
  "components": {
    "schemas": {
      "HealthcheckResponse": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Version of the application",
            "default": "1.0.0",
            "examples": [
              "1.0.0"
            ]
          }
        },
        "type": "object",
        "title": "HealthcheckResponse",
        "description": "Result of an API health check.\n\nReports the running application version so a caller can confirm the server is up and identify which\nbuild is currently deployed."
      },
      "RestartResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Message indicating the restart request was received",
            "default": "Restart request received. Server will restart shortly.",
            "examples": [
              "Restart request received. Server will restart shortly."
            ]
          }
        },
        "type": "object",
        "title": "RestartResponse",
        "description": "Acknowledgement of a server restart request.\n\nReturned immediately when a restart is requested; the server process exits with a non-zero code shortly\nafter this response is sent, and the supervising platform starts it again."
      },
      "ShutdownResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Message indicating the shutdown request was received",
            "default": "Shutdown request received. Server will exit shortly.",
            "examples": [
              "Shutdown request received. Server will exit shortly."
            ]
          }
        },
        "type": "object",
        "title": "ShutdownResponse",
        "description": "Acknowledgement of a server shutdown request.\n\nReturned immediately when a shutdown is requested; the server process exits shortly after this response\nis sent."
      },
      "ProblemDetails": {
        "description": "RFC 9457 problem details describing an error response.\n\nReturned (as application/problem+json) for error responses so clients and codegen tools such as Kiota\nhave a consistent, machine-readable error shape.",
        "properties": {
          "type": {
            "default": "about:blank",
            "description": "A URI reference identifying the problem type.",
            "examples": [
              "about:blank"
            ],
            "title": "Type",
            "type": "string"
          },
          "title": {
            "description": "A short, human-readable summary of the problem.",
            "examples": [
              "Internal Server Error"
            ],
            "title": "Title",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code for this problem.",
            "examples": [
              500
            ],
            "format": "int32",
            "maximum": 599,
            "minimum": 100,
            "title": "Status",
            "type": "integer"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "An unexpected error occurred."
            ],
            "title": "Detail",
            "type": "string",
            "x-ms-primary-error-message": true
          },
          "instance": {
            "description": "The path of the request that met this problem, without its query string.",
            "examples": [
              "/api/healthcheck"
            ],
            "title": "Instance",
            "type": "string"
          },
          "errorType": {
            "default": null,
            "description": "The internal exception class name, when available.",
            "examples": [
              "ValueError"
            ],
            "title": "Error Type",
            "type": [
              "string",
              "null"
            ]
          },
          "traceId": {
            "description": "Identifies this occurrence in the server's logs: search them for it to find what led to the problem.",
            "examples": [
              "0193b5e2-4c1f-7a8d-9e3b-2f6c8d1a5b74"
            ],
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "traceId"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ParameterLocation": {
        "description": "Where in the request a parameter is sent, spelled as OpenAPI's parameter `in` spells it.",
        "enum": [
          "query",
          "path",
          "header",
          "cookie"
        ],
        "title": "ParameterLocation",
        "type": "string"
      },
      "ValidationIssue": {
        "description": "One reason a request failed validation, and where in the request it is.",
        "properties": {
          "detail": {
            "description": "What is wrong with the value, in words a person can act on.",
            "examples": [
              "Input should be a valid integer, unable to parse string as an integer"
            ],
            "title": "Detail",
            "type": "string"
          },
          "code": {
            "description": "A machine-readable reason for the issue, from Pydantic's error types; more may be added.",
            "examples": [
              "int_parsing"
            ],
            "title": "Code",
            "type": "string"
          },
          "pointer": {
            "default": null,
            "description": "Where the invalid value is in the JSON request body, as a JSON Pointer (RFC 6901) in URI fragment form; `#` is the whole body. Present only for an issue in the body.",
            "examples": [
              "#/items/2"
            ],
            "title": "Pointer",
            "type": "string"
          },
          "parameter": {
            "default": null,
            "description": "The name of the invalid query, path, header or cookie parameter. Present only with `in`.",
            "examples": [
              "prependV"
            ],
            "title": "Parameter",
            "type": "string"
          },
          "in": {
            "$ref": "#/components/schemas/ParameterLocation",
            "default": null,
            "description": "Where the invalid parameter is sent, spelled as OpenAPI's parameter `in`. Present only with `parameter`.",
            "examples": [
              "query"
            ],
            "title": "Location"
          }
        },
        "required": [
          "detail",
          "code"
        ],
        "title": "ValidationIssue",
        "type": "object"
      },
      "ValidationProblemDetails": {
        "description": "RFC 9457 problem details for a request that failed validation, listing each invalid value.",
        "properties": {
          "type": {
            "default": "about:blank",
            "description": "A URI reference identifying the problem type.",
            "examples": [
              "about:blank"
            ],
            "title": "Type",
            "type": "string"
          },
          "title": {
            "description": "A short, human-readable summary of the problem.",
            "examples": [
              "Internal Server Error"
            ],
            "title": "Title",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code for this problem.",
            "examples": [
              500
            ],
            "format": "int32",
            "maximum": 599,
            "minimum": 100,
            "title": "Status",
            "type": "integer"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "An unexpected error occurred."
            ],
            "title": "Detail",
            "type": "string",
            "x-ms-primary-error-message": true
          },
          "instance": {
            "description": "The path of the request that met this problem, without its query string.",
            "examples": [
              "/api/healthcheck"
            ],
            "title": "Instance",
            "type": "string"
          },
          "errorType": {
            "default": null,
            "description": "The internal exception class name, when available.",
            "examples": [
              "ValueError"
            ],
            "title": "Error Type",
            "type": [
              "string",
              "null"
            ]
          },
          "traceId": {
            "description": "Identifies this occurrence in the server's logs: search them for it to find what led to the problem.",
            "examples": [
              "0193b5e2-4c1f-7a8d-9e3b-2f6c8d1a5b74"
            ],
            "title": "Trace Id",
            "type": "string"
          },
          "errors": {
            "description": "Each invalid value in the request. Empty when the route itself rejected the request rather than its validation finding an invalid value.",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "title": "Errors",
            "type": "array"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "traceId",
          "errors"
        ],
        "title": "ValidationProblemDetails",
        "type": "object"
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Server health and lifecycle operations."
    }{% endraw %}{% if backend_uses_graphql %}{% raw %},
    {
      "name": "graphql",
      "description": "GraphQL endpoint"
    }{% endraw %}{% endif %}{% raw %}
  ]
}{% endraw %}