{% raw %}[project]
name = "backend-api"
version = "0.1.0"
description = "{% endraw %}{{description}}{% raw %}"

readme = "README.md"
requires-python = ">={% endraw %}{{ python_version }}{% raw %}"

dependencies = [
    # Specific to this repository

    # Managed by upstream template
    "fastapi{% endraw %}{{ fastapi_version }}{% raw %}",
    "fastapi-offline{% endraw %}{{ fastapi_offline_version }}{% raw %}",
    "starlette{% endraw %}{{ starlette_version }}{% raw %}",
    "uuid-utils{% endraw %}{{ uuid_utils_version }}{% raw %}",{% endraw %}{% if backend_uses_graphql %}{% raw %}
    "strawberry-graphql{% endraw %}{{ strawberry_graphql_version }}{% raw %}",
    "graphql-core~=3.2.11",{% endraw %}{% endif %}{% raw %}
    "pip-system-certs>=5.3",{% endraw %}{% if install_as_windows_service %}{% raw %}
    "pywin32>=312; sys_platform == 'win32'",{% endraw %}{% endif %}{% raw %}
    "pydantic{% endraw %}{{ pydantic_version }}{% raw %}",
    "uvicorn{% endraw %}{{ uvicorn_version }}{% raw %}",
    "structlog{% endraw %}{{ structlog_version }}{% raw %}",{% endraw %}{% if backend_source_uses_kiota %}{% raw %}
    "httpx{% endraw %}{{ httpx_version }}{% raw %}",
    "microsoft-kiota-bundle{% endraw %}{{ python_kiota_bundle_version }}{% raw %}",{% endraw %}{% endif %}{% raw %}{% endraw %}{% if is_circuit_python_driver %}{% raw %}
    "pyserial>=3.5",
    "psutil>=7.2.2",
    "zeroconf>=0.149.0",
    "semver>=3.0.4",{% endraw %}{% endif %}{% raw %}
]


[dependency-groups]
dev = [
    # Specific to this repository


    # Managed by upstream template{% endraw %}{% if not backend_source_uses_kiota %}{% raw %}
    "httpx{% endraw %}{{ httpx_version }}{% raw %}",
    "microsoft-kiota-bundle{% endraw %}{{ python_kiota_bundle_version }}{% raw %}",{% endraw %}{% endif %}{% raw %}{% endraw %}{% if backend_uses_graphql %}{% raw %}
    "ariadne-codegen[subscriptions]{% endraw %}{{ ariadne_codegen_version }}{% raw %}",{% endraw %}{% endif %}{% raw %}
    "httpx2{% endraw %}{{ httpx2_version }}{% raw %}",
    "pyhumps>=3.8.0",
    "pyrefly{% endraw %}{{ pyrefly_version }}{% raw %}",
    "syrupy{% endraw %}{{ syrupy_version }}{% raw %}",
    "mutmut{% endraw %}{{ mutmut_version }}{% raw %}",
    "pytest{% endraw %}{{ pytest_version }}{% raw %}",
    "pytest-cov{% endraw %}{{ pytest_cov_version }}{% raw %}",
    "pytest-randomly{% endraw %}{{ pytest_randomly_version }}{% raw %}",
    "pytest-mock{% endraw %}{{ pytest_mock_version }}{% raw %}",
    "pytest-timeout{% endraw %}{{ pytest_timeout_version }}{% raw %}",
    "pytest-asyncio{% endraw %}{{ pytest_asyncio_version }}{% raw %}",{% endraw %}{% if backend_makes_api_calls %}{% raw %}
    "pytest-recording{% endraw %}{{ pytest_recording_version }}{% raw %}",
    "vcrpy{% endraw %}{{ vcrpy_version }}{% raw %}",{% endraw %}{% endif %}{% raw %}{% endraw %}{% if deploy_as_executable %}{% raw %}
    "pyinstaller{% endraw %}{{ pyinstaller_version }}{% raw %}",{% endraw %}{% endif %}{% raw %}{% endraw %}{% if install_as_windows_service %}{% raw %}
    "types-pywin32>=312.0.0.20261006", # pywin32 itself only installs on Windows; the stubs type win_service.py on every platform{% endraw %}{% endif %}{% raw %}{% endraw %}{% if is_circuit_python_driver %}{% raw %}
    "pytest-reserial{% endraw %}{{ pytest_reserial_version }}{% raw %}",
    "circup>=3.0.1",
    "adafruit-circuitpython-busdevice==5.2.17", # no specific reason for this version, just pinning to ensure no unintended drift during firmware builds
    "adafruit-circuitpython-register==1.11.3", # no specific reason for this version, just pinning to ensure no unintended drift during firmware builds{% endraw %}{% endif %}{% raw %}
]{% endraw %}{% if backend_uses_graphql %}{% raw %}

[tool.ariadne-codegen]
schema_path = "src/backend_api/graphql/schema.graphql"
include_comments = "none"
queries_path = "tests/e2e/queries/"
async_client = false
target_package_name = "backend"
target_package_path = "tests/e2e/generated/graphql"
enable_custom_operations = true{% endraw %}{% endif %}{% raw %}

[tool.uv]
package = true

[tool.tach]
source_roots = ["src", "."]
exclude = [".venv", "**/__pycache__", "**/*.egg-info", "mutants", "scripts"]

# Never import from a conftest.py (https://docs.pytest.org/en/stable/how-to/writing_plugins.html#conftest-py-local-per-directory-plugins);
# put shared helpers in a regular module instead. Declaring `tests` as a module is what makes tach check the tests'
# imports at all; a file outside every module is never checked.
[[tool.tach.modules]]
path = "tests"
cannot_depend_on = ["tests.**.conftest"]

# Makes each conftest.py its own module, so the rule above has something to match. tach puts a file only in its most
# specific module, so conftests are not part of `tests` and need the rule repeated to block conftest-to-conftest imports.
# `visibility = []` also rejects any module that lists a conftest in its `depends_on`. It can't stop a module that omits
# `depends_on`, so any other module declared under `tests` needs the same `cannot_depend_on` line.
[[tool.tach.modules]]
path = "tests.**.conftest"
cannot_depend_on = ["tests.**.conftest"]
visibility = []

[tool.tach.external]
# anyio arrives transitively through starlette; logger_config.py imports it only to locate its frames for log suppression.{% endraw %}{% if backend_source_uses_kiota %}{% raw %}
# httpx and microsoft-kiota-bundle are for the Kiota client that codegen generates into the project.{% endraw %}{% endif %}{% raw %}{% endraw %}{% if is_circuit_python_driver %}{% raw %}
# pyserial, psutil, zeroconf and semver are for the device driver code each project writes.{% endraw %}{% endif %}{% raw %}{% endraw %}{% if install_as_windows_service %}{% raw %}
# pywin32 installs only on Windows, so elsewhere tach cannot map its modules back to it.{% endraw %}{% endif %}{% raw %}
exclude = [
    "anyio",{% endraw %}{% if backend_source_uses_kiota %}{% raw %}
    "httpx",
    "microsoft_kiota_bundle",{% endraw %}{% endif %}{% raw %}{% endraw %}{% if is_circuit_python_driver %}{% raw %}
    "pyserial",
    "psutil",
    "zeroconf",
    "semver",{% endraw %}{% endif %}{% raw %}{% endraw %}{% if install_as_windows_service %}{% raw %}
    "pywin32",
    "servicemanager",
    "win32security",
    "win32service",
    "win32serviceutil",
    "winerror",{% endraw %}{% endif %}{% raw %}
]

[tool.mutmut]
source_paths = [ "src/backend_api/" ]
pytest_add_cli_args_test_selection = [ "tests/unit/" ]
pytest_add_cli_args = [ "--no-cov" ]
also_copy = [
    "src/static",
    ]
mutate_only_covered_lines = true
do_not_mutate = [   "*/generated/*" , # do not mutate generated code, this is created by external tooling that has undergone its own testing
                    "*/logger_config.py", # not thoroughly tested
                    "*/app_runner.py", # not thoroughly tested
                    "*/fast_api_exception_handlers.py", # not thoroughly tested
                    "*/base/lib.py", # not thoroughly tested here, needs to become a library
 ]
# mutmut runs this from backend/mutants/. The dedicated config points pyrefly at the generated
# mutants tree and excludes do_not_mutate files, so every reported type error falls inside a mutant
# function and mutmut can attribute it. Without it, pyrefly checks the real source from the mutants/
# cwd and reports errors on non-mutant lines, crashing with "Could not find mutant for type error".
type_check_command = ['uv', 'run', 'pyrefly', 'check', '--output-format=json', '-c', '../../.config/pyrefly.mutmut.toml']
do_not_mutate_patterns = [
    # disable mutations of all logger.info/debug/... statements
    'logger\.\w+',
    # disable mutations of assert statements (for type narrowing...it often messes with the messages)
    'assert .+',
    'f"Expected .+,.+got.+\{type\(.+\}.+\{.+',
    # disable mutating untested exceptions
    'raise NotImplementedError.+',
    'raise AssertionError.+',
]{% endraw %}{% if is_circuit_python_driver %}{% raw %}

[tool.circup.bundle-versions]
# WORKAROUND for https://github.com/adafruit/circup/issues/258 — circup currently strips `==X`
# specifiers when reading requirements.txt (circup/command_utils.py: libraries_from_requirements),
# so `circup install -r` installs whichever library version the active bundle release happens to
# contain, regardless of the pins we write into requirements.txt. Pinning the bundle release tag
# here makes that install deterministic: the bundle has exactly one version of each library, so
# whatever requirements.txt asks for, circup ends up installing the same versions every run, which
# is what the freeze-vs-requirements check in scripts/install_firmware_dependencies.py relies on.
# Remove this section once circup honors per-library pins in requirements.txt directly; the library
# version pins above stay either way. Bump both the dates here and the library pins together when
# intentionally moving to a newer bundle.
"adafruit/Adafruit_CircuitPython_Bundle" = "20260508" # no specific reason for this bundle version, just pinning to ensure no unintended drift during firmware builds (it contains the library versions currently pinned in pyproject.toml)
"adafruit/CircuitPython_Community_Bundle" = "20260414" # no specific reason for this bundle version, just pinning to ensure no unintended drift during firmware builds (it contains the library versions currently pinned in pyproject.toml){% endraw %}{% endif %}{% raw %}{% endraw %}
