{% raw %}name: CI

on:
  push:
    branches-ignore:
      - 'gh-readonly-queue/**' # don't run (again) when on these special branches created during merge groups; the `on: merge_group` already triggers it.
  merge_group:
  pull_request:
  workflow_dispatch: # a manual run executes every job for the chosen branch, as information only: it posts no required-check

env:
  PYTHONUNBUFFERED: True
  PRE_COMMIT_HOME: ${{ github.workspace }}/.precommit_cache

permissions:
  id-token: write # needed to assume OIDC roles (e.g. for downloading from CodeArtifact)
  contents: read # need to explicitly provide this whenever defining permissions because the default value is 'none' for anything not explicitly set when permissions are defined

jobs:
  get-values:
    uses: ./.github/workflows/get-values.yaml
    permissions:
      contents: write # needed for updating dependabot branches

  check-skip-duplicate:
    runs-on: {% endraw %}{{ gha_linux_runner }}{% raw %}
    timeout-minutes: {% endraw %}{{ gha_short_timeout_minutes }}{% raw %}
    permissions:
      contents: read
      pull-requests: read # needed to check if PR exists for current branch
    outputs:
      should-run: ${{ steps.check.outputs.should-run }}
    steps:
      - name: Checkout code
        uses: actions/checkout@{% endraw %}{{ gha_checkout }}{% raw %}
        with:
          persist-credentials: false
      - id: check
        uses: ./.github/actions/check-skip-duplicates

  changes:
    name: Classify changed paths
    runs-on: {% endraw %}{{ gha_linux_runner }}{% raw %}
    timeout-minutes: {% endraw %}{{ gha_short_timeout_minutes }}{% raw %}
    permissions:
      contents: read
      pull-requests: read # dorny/paths-filter reads a PR's file list through the API
    outputs:
      # One boolean per class in .github/path-filters.yaml, as a JSON object:
      # fromJSON(needs.changes.outputs.classes).<class>
      classes: ${{ steps.resolve.outputs.classes }}
    steps:
      - name: Decide whether the diff matters at all
        id: policy
        env:
          # The default branch always runs everything, so a class that was wrong on a feature branch or in the merge
          # queue is still caught there. A manual run is the way to get that full run for one branch.
          FORCED_BY: ${{ github.ref == format('refs/heads/{0}', github.event.repository.default_branch) && 'the default branch' || github.event_name == 'workflow_dispatch' && 'a manual run' || '' }}
        run: |
          echo "forced_by=$FORCED_BY" >> "$GITHUB_OUTPUT"
          if [ -n "$FORCED_BY" ]; then
            echo "run_everything=true" >> "$GITHUB_OUTPUT"
          else
            echo "run_everything=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Checkout code
        uses: actions/checkout@{% endraw %}{{ gha_checkout }}{% raw %}
        with:
          persist-credentials: false
          # On push and merge_group events dorny/paths-filter compares against a base commit through git. Without
          # persisted credentials it cannot fetch that commit from a private repository, so the full history is cloned
          # up front and the base is already present locally.
          # TODO: a full clone gets slow once a repository's history is large. Consider fetching only the base commit
          # instead: resolve it (merge_group.base_sha, or the merge base from the compare API on push), fetch it at
          # depth 1 with a one-off auth header that is never persisted, and pass it to the filter as `base`.
          fetch-depth: 0

      - name: Match the changed files against the path classes
        if: steps.policy.outputs.run_everything != 'true'
        id: filter
        uses: dorny/paths-filter@{% endraw %}{{ gha_paths_filter }}{% raw %}
        with:
          filters: .github/path-filters.yaml
          predicate-quantifier: some-with-excludes
          list-files: json

      - name: Resolve the class outputs
        id: resolve
        env:
          RUN_EVERYTHING: ${{ steps.policy.outputs.run_everything }}
          FORCED_BY: ${{ steps.policy.outputs.forced_by }}
          # Holds file names from the PR, so it only ever travels through env and jq, never a shell expansion
          FILTER_OUTPUTS: ${{ toJSON(steps.filter.outputs) }}
        run: |
          # A code file that no other class claims forces every class on: an unclassified path can affect anything, so
          # nothing may be skipped because of it.
          classes=$(yq 'keys | .[]' .github/path-filters.yaml)
          jq -n --arg run_everything "$RUN_EVERYTHING" --arg forced_by "$FORCED_BY" --argjson outputs "$FILTER_OUTPUTS" --arg classes "$classes" '
            def files($class): $outputs[$class + "_files"] // "[]" | fromjson;
            ($classes | split("\n") | map(select(length > 0))) as $classes
            | (files("code") - ([$classes[] | select(. != "code") | files(.)] | add // [])) as $unclassified
            | ($run_everything == "true" or ($unclassified | length) > 0) as $force
            | {
                forced_by: $forced_by,
                unclassified: $unclassified,
                classes: ([$classes[] | {key: ., value: ($force or $outputs[.] == "true")}] | from_entries)
              }
          ' > "$RUNNER_TEMP/resolved.json"
          echo "classes=$(jq -c .classes "$RUNNER_TEMP/resolved.json")" >> "$GITHUB_OUTPUT"
          jq -r '"classes: \(.classes)", (if .forced_by != "" then "every class forced on by \(.forced_by)" elif (.unclassified | length) > 0 then "every class forced on by unclassified paths:", .unclassified[] else empty end)' "$RUNNER_TEMP/resolved.json" | tee -a "$GITHUB_STEP_SUMMARY"

  lint:
    needs:
      - get-values
      - check-skip-duplicate
    if: needs.check-skip-duplicate.outputs.should-run == 'true'
    name: Pre-commit
    uses: ./.github/workflows/pre-commit.yaml
    permissions:
      contents: write # needed for mutex
      id-token: write # needed to assume OIDC roles (e.g. for downloading from CodeArtifact)
    with:
      python-version: {% endraw %}{{ python_version }}{% raw %}
      setup-node: true
      node-version: {% endraw %}{{ node_version }}{% raw %}

  unit-test-frontend:
    name: Unit Test Frontend${{ fromJSON(needs.changes.outputs.classes).frontend != true && ' (skipped, no frontend changes)' || '' }}
    timeout-minutes: {% endraw %}{{ gha_medium_timeout_minutes }}{% raw %}
    runs-on: {% endraw %}{{ gha_linux_runner }}{% raw %}
    needs:
      - lint
      - check-skip-duplicate
      - changes
    if: needs.check-skip-duplicate.outputs.should-run == 'true'
    env:
      RUN_JOB: ${{ fromJSON(needs.changes.outputs.classes).frontend }}
    steps:
      - name: Checkout code
        if: env.RUN_JOB == 'true'
        uses: actions/checkout@{% endraw %}{{ gha_checkout }}{% raw %}

      - name: Install latest versions of packages
        if: env.RUN_JOB == 'true'
        uses: ./.github/actions/install_deps
        with:
          node-version: {% endraw %}{{ node_version }}{% raw %}
          skip-installing-ssm-plugin-manager: true

      - name: Unit test
        if: env.RUN_JOB == 'true'
        run: pnpm --dir=frontend test-unit

      - name: Upload test coverage on failure
        if: ${{ failure() }}
        uses: actions/upload-artifact@{% endraw %}{{ gha_upload_artifact }}{% raw %}
        with:
          name: frontend-test-coverage
          path: frontend/.coverage
          if-no-files-found: error
          include-hidden-files: true
          retention-days: 5{% endraw %}{% if has_backend %}{% raw %}

  unit-test-backend:
    name: Unit Test Backend${{ fromJSON(needs.changes.outputs.classes).backend != true && ' (skipped, no backend changes)' || '' }}
    timeout-minutes: {% endraw %}{{ gha_medium_timeout_minutes }}{% raw %}
    needs:
      - lint
      - check-skip-duplicate
      - changes
    if: needs.check-skip-duplicate.outputs.should-run == 'true'
    env:
      RUN_JOB: ${{ fromJSON(needs.changes.outputs.classes).backend }}
    strategy:
      matrix:
        os:
          - "{% endraw %}{{ gha_linux_runner }}{% raw %}"{% endraw %}{% if use_windows_in_ci %}
          - {{ gha_windows_runner }}{% endif %}{% raw %}
    runs-on: ${{ matrix.os }}
    steps:{% endraw %}{% if use_windows_in_ci %}
      - name: Allow long file paths
        if: env.RUN_JOB == 'true' && runner.os == 'Windows'
        # Some tooling (e.g. vcrpy, syrupy) generates file names past the 260 character limit Windows
        # defaults to. This has to happen before the checkout that writes those files.
        run: git config --global core.longpaths true
{% endif %}{% raw %}
      - name: Checkout code
        if: env.RUN_JOB == 'true'
        uses: actions/checkout@{% endraw %}{{ gha_checkout }}{% raw %}

      - name: Install latest versions of python packages
        if: env.RUN_JOB == 'true'
        uses: ./.github/actions/install_deps
        with:
          python-version: {% endraw %}{{ python_version }}{% raw %}
          skip-installing-ssm-plugin-manager: true

      - name: Unit test
        if: env.RUN_JOB == 'true'
        run: uv --directory=backend run pytest tests/unit --durations=5

      - name: Upload test coverage on failure
        if: ${{ failure() }}
        uses: actions/upload-artifact@{% endraw %}{{ gha_upload_artifact }}{% raw %}
        with:
          name: backend-test-coverage-${{ matrix.os }}
          path: backend/coverage-report-pytest
          if-no-files-found: error
          retention-days: 5{% endraw %}{% endif %}{% raw %}

  build-frontend:
    needs:
      - lint
      - unit-test-frontend{% endraw %}{% if has_backend %}{% raw %}
      - unit-test-backend{% endraw %}{% endif %}{% raw %}
      - check-skip-duplicate
      - changes
{% endraw %}{% if not deploy_as_executable %}{% raw %}    if: needs.check-skip-duplicate.outputs.should-run == 'true' && fromJSON(needs.changes.outputs.classes).code
    uses: ./.github/workflows/build-docker-image.yaml
    permissions:
      contents: write # needed for mutex
      id-token: write # needed to assume OIDC roles (e.g. for downloading from CodeArtifact)
    with:
      context: ./frontend
      build-contexts: repo-root=.
      additional-hash-paths: pnpm-workspace.yaml pnpm-lock.yaml
      save-as-artifact: true
      tag-for-production: ${{ github.ref == 'refs/heads/main' }}
      repository: {% endraw %}{{ frontend_ecr_base_url }}{% raw %}
      image_name: {% endraw %}{{ frontend_image_name }}{% raw %}
{% endraw %}{% if push_to_ecr %}{% raw %}      push-role-name: {% endraw %}{{ frontend_ecr_push_role_name }}{% endif %}{% else %}{% raw %}
    name: Build Frontend${{ fromJSON(needs.changes.outputs.classes).code != true && ' (skipped, no code changes)' || '' }}
    if: needs.check-skip-duplicate.outputs.should-run == 'true'
    env:
      RUN_JOB: ${{ fromJSON(needs.changes.outputs.classes).code }}
    timeout-minutes: {% endraw %}{{ gha_medium_timeout_minutes }}{% raw %}
    runs-on: {% endraw %}{{ gha_linux_runner }}{% raw %}
    steps:
      - name: Checkout code
        if: env.RUN_JOB == 'true'
        uses: actions/checkout@{% endraw %}{{ gha_checkout }}{% raw %}

      - name: Install latest versions of node packages
        if: env.RUN_JOB == 'true'
        uses: ./.github/actions/install_deps
        with:
          node-version: {% endraw %}{{ node_version }}{% raw %}
          skip-installing-ssm-plugin-manager: true

      - name: Build frontend
        if: env.RUN_JOB == 'true'
        run: task build-frontend

      - name: Upload build artifact
        if: env.RUN_JOB == 'true'
        uses: actions/upload-artifact@{% endraw %}{{ gha_upload_artifact }}{% raw %}
        with:
          name: frontend-static-assets
          path: frontend/.output/public/**/*
          if-no-files-found: error
          retention-days: 5

{% endraw %}{% endif %}{% raw %}

{% endraw %}{% if has_backend %}{% raw %}{% endraw %}{% if not deploy_as_executable %}{% raw %}
  build-backend:
    needs:
      - lint
      - unit-test-frontend
      - unit-test-backend
      - check-skip-duplicate
      - changes
    if: needs.check-skip-duplicate.outputs.should-run == 'true' && fromJSON(needs.changes.outputs.classes).code
    uses: ./.github/workflows/build-docker-image.yaml
    permissions:
      contents: write # needed for mutex
      id-token: write # needed to assume OIDC roles (e.g. for downloading from CodeArtifact)
    with:
      context: ./backend
      save-as-artifact: true
      tag-for-production: ${{ github.ref == 'refs/heads/main' }}
      repository: {% endraw %}{{ backend_ecr_base_url }}{% raw %}
      image_name: {% endraw %}{{ backend_image_name }}{% raw %}
{% endraw %}{% if push_to_ecr %}{% raw %}      push-role-name: {% endraw %}{{ backend_ecr_push_role_name }}{% endif %}{% else %}{% raw %}
  build-backend:
    needs:
      - lint
      - unit-test-frontend
      - unit-test-backend
      - build-frontend
      - check-skip-duplicate
      - changes
    name: Build Backend${{ fromJSON(needs.changes.outputs.classes).code != true && ' (skipped, no code changes)' || '' }}
    if: needs.check-skip-duplicate.outputs.should-run == 'true'
    env:
      RUN_JOB: ${{ fromJSON(needs.changes.outputs.classes).code }}
    strategy:
      matrix:
        os:
          - "{% endraw %}{{ gha_linux_runner }}{% raw %}"{% endraw %}{% if use_windows_in_ci %}
          - {{ gha_windows_runner }}{% endif %}{% raw %}
    timeout-minutes: {% endraw %}{{ gha_medium_timeout_minutes }}{% raw %}
    runs-on: ${{ matrix.os }}

    steps:{% endraw %}{% if use_windows_in_ci %}
      - name: Allow long file paths
        if: env.RUN_JOB == 'true' && runner.os == 'Windows'
        # Some tooling (e.g. vcrpy, syrupy) generates file names past the 260 character limit Windows
        # defaults to. This has to happen before the checkout that writes those files.
        run: git config --global core.longpaths true
{% endif %}{% raw %}
      - name: Checkout code
        if: env.RUN_JOB == 'true'
        uses: actions/checkout@{% endraw %}{{ gha_checkout }}{% raw %}
      - name: Download Frontend Static Assets
        if: env.RUN_JOB == 'true'
        uses: actions/download-artifact@{% endraw %}{{ gha_download_artifact }}{% raw %}
        with:
          name: frontend-static-assets
          path: backend/src/static

      - name: Install latest versions of python packages
        if: env.RUN_JOB == 'true'
        uses: ./.github/actions/install_deps
        with:
          python-version: {% endraw %}{{ python_version }}{% raw %}
          skip-installing-ssm-plugin-manager: true

      - name: Build application
        if: env.RUN_JOB == 'true'
        run: task bundle-executable-from-staged-static
      - name: Tar files to preserve permissions on Linux during artifact upload # https://github.com/actions/upload-artifact?tab=readme-ov-file#permission-loss
        if: env.RUN_JOB == 'true'
        run: tar -cvf app.tar backend/dist/{% endraw %}{{ repo_name }}{% raw %}
      - name: Upload application artifact (Windows)
        if: env.RUN_JOB == 'true' && runner.os == 'Windows'
        uses: actions/upload-artifact@{% endraw %}{{ gha_upload_artifact }}{% raw %}
        with:
          name: built-{% endraw %}{{ repo_name }}{% raw %}-${{ matrix.os }}
          path: backend/dist/{% endraw %}{{ repo_name }}{% raw %}/**/*
          if-no-files-found: error
          retention-days: 5
      - name: Upload application artifact (Linux)
        if: env.RUN_JOB == 'true' && runner.os == 'Linux'
        uses: actions/upload-artifact@{% endraw %}{{ gha_upload_artifact }}{% raw %}
        with:
          name: built-{% endraw %}{{ repo_name }}{% raw %}-${{ matrix.os }}
          path: app.tar
          if-no-files-found: error
          retention-days: 5{% endraw %}{% endif %}{% raw %}{% endraw %}{% endif %}{% raw %}


  test-compiled-frontend-dev:
    name: Test the compiled Frontend for pnpm dev mode${{ fromJSON(needs.changes.outputs.classes).frontend != true && ' (skipped, no frontend changes)' || '' }}
    timeout-minutes: {% endraw %}{{ gha_medium_timeout_minutes }}{% raw %}
    runs-on: {% endraw %}{{ gha_linux_runner }}{% raw %}
    env:
      RUN_JOB: ${{ fromJSON(needs.changes.outputs.classes).frontend }}
      INSTALL_PLAYWRIGHT_BROWSERS: "1" # createPage() drives a real browser
    needs:
      - build-frontend{% endraw %}{% if has_backend %}{% raw %}
      - build-backend{% endraw %}{% endif %}{% raw %}
      - check-skip-duplicate
      - changes
    if: needs.check-skip-duplicate.outputs.should-run == 'true'
    steps:
      - name: Checkout code
        if: env.RUN_JOB == 'true'
        uses: actions/checkout@{% endraw %}{{ gha_checkout }}{% raw %}

      - name: Install latest versions of node packages
        if: env.RUN_JOB == 'true'
        uses: ./.github/actions/install_deps
        with:
          node-version: {% endraw %}{{ node_version }}{% raw %}
          skip-installing-ssm-plugin-manager: true

      - name: Test
        if: env.RUN_JOB == 'true'
        run: pnpm --dir=frontend test-compiled-dev{% endraw %}{% if is_circuit_python_driver %}{% raw %}

  e2e-test-k3d:
    name: End-to-end Testing on k3d${{ fromJSON(needs.changes.outputs.classes).code != true && ' (skipped, no code changes)' || '' }}
    timeout-minutes: {% endraw %}{{ gha_xlong_timeout_minutes }}{% raw %}
    runs-on: "{% endraw %}{{ gha_linux_runner }}{% raw %}"
    needs:
      - build-frontend
      - build-backend
      - check-skip-duplicate
      - changes
    if: needs.check-skip-duplicate.outputs.should-run == 'true'
    env:
      RUN_JOB: ${{ fromJSON(needs.changes.outputs.classes).code }}
    steps:
      - name: Checkout code
        if: env.RUN_JOB == 'true'
        uses: actions/checkout@{% endraw %}{{ gha_checkout }}{% raw %}

      - name: Download Backend Artifact
        if: env.RUN_JOB == 'true'
        uses: actions/download-artifact@{% endraw %}{{ gha_download_artifact }}{% raw %}
        with:
          name: ${{ needs.build-backend.outputs.artifact-name }}
          path: deployment-package-folder

      - name: Download Frontend Artifact
        if: env.RUN_JOB == 'true'
        uses: actions/download-artifact@{% endraw %}{{ gha_download_artifact }}{% raw %}
        with:
          name: {% endraw %}{{ frontend_image_name | replace('/', '-') }}{% raw %}
          path: deployment-package-folder

      - name: Load docker images
        if: env.RUN_JOB == 'true'
        run: |
          ls deployment-package-folder -a
          # load all images in the folder
          ls -1 deployment-package-folder/*.tar | xargs --no-run-if-empty -L 1 docker load -i

      - name: Retag loaded images to stable local names
        if: env.RUN_JOB == 'true'
        run: |
          docker tag ${{ needs.build-frontend.outputs.full-image-tag }} {% endraw %}{{ frontend_image_name }}{% raw %}:local
          docker tag ${{ needs.build-backend.outputs.full-image-tag }} {% endraw %}{{ backend_image_name }}{% raw %}:local

      - name: Create k3d cluster
        if: env.RUN_JOB == 'true'
        # k3d runs k3s inside Docker containers. NodePort iptables rules only handle traffic
        # arriving via Docker port publishing (host → container), not inter-container traffic.
        # --port with @server:0 uses Docker port publishing so localhost:30060/30061 on the
        # runner reaches the NodePort correctly. We use 0 agents so pods always land on the
        # server node, making the @server:0 mapping deterministic.
        # Locally (Rancher Desktop) NodePorts are on localhost directly; none of this is needed.
        uses: AbsaOSS/k3d-action@{% endraw %}{{ gha_absaoss_k3d }}{% raw %}
        with:
          cluster-name: e2e
          k3d-version: {% endraw %}{{ k3d_version }}{% raw %}
          args: >-
            --agents 0
            --port {% endraw %}{{ frontend_nodeport_number }}{% raw %}:{% endraw %}{{ frontend_nodeport_number }}{% raw %}@server:0
            --port {% endraw %}{{ backend_nodeport_number }}{% raw %}:{% endraw %}{{ backend_nodeport_number }}{% raw %}@server:0

      - name: Setup Helm
        if: env.RUN_JOB == 'true'
        uses: Azure/setup-helm@{% endraw %}{{ gha_azure_setup_helm }}{% raw %}
        with:
          version: {% endraw %}{{ helm_version }}{% raw %}

      - name: Setup kubectl
        if: env.RUN_JOB == 'true'
        uses: Azure/setup-kubectl@{% endraw %}{{ gha_azure_setup_kubectl }}{% raw %}
        with:
          version: {% endraw %}{{ kubectl_version }}{% raw %}

      - name: Get runner IP
        if: env.RUN_JOB == 'true'
        run: |
          RUNNER_IP=$(hostname -I | awk '{print $1}')
          echo "Runner IP: $RUNNER_IP"
          echo "RUNNER_IP=$RUNNER_IP" >> $GITHUB_ENV

      - name: Create app namespace
        if: env.RUN_JOB == 'true'
        run: kubectl create ns app

      - name: Wait for k3d node ready
        if: env.RUN_JOB == 'true'
        run: kubectl wait --for=condition=Ready node --all --timeout=60s

      - name: Import images into k3d
        if: env.RUN_JOB == 'true'
        run: |
          k3d image import {% endraw %}{{ frontend_image_name }}{% raw %}:local {% endraw %}{% if has_backend %}{{ backend_image_name }}{% raw %}:local{% endraw %}{% endif %}{% raw %} -c e2e
          # k3d image import exits 0 even when the internal `ctr images import` exec inside the node
          # fails (e.g. containerd not fully ready after cluster creation). Verify and retry once.
          if ! docker exec k3d-e2e-server-0 ctr -n k8s.io images ls | grep -Fq -- {% endraw %}{{ frontend_image_name }}{% raw %}:local{% endraw %}{% if has_backend %}{% raw %} || ! docker exec k3d-e2e-server-0 ctr -n k8s.io images ls | grep -Fq -- {% endraw %}{{ backend_image_name }}{% raw %}:local{% endraw %}{% endif %}{% raw %}; then
            echo "Images not found after first import, retrying..."
            sleep 2
            k3d image import {% endraw %}{{ frontend_image_name }}{% raw %}:local {% endraw %}{% if has_backend %}{{ backend_image_name }}{% raw %}:local{% endraw %}{% endif %}{% raw %} -c e2e
          fi
          docker exec k3d-e2e-server-0 ctr -n k8s.io images ls | grep -Fq -- {% endraw %}{{ frontend_image_name }}{% raw %}:local{% endraw %}{% if has_backend %}{% raw %}
          docker exec k3d-e2e-server-0 ctr -n k8s.io images ls | grep -Fq -- {% endraw %}{{ backend_image_name }}{% raw %}:local{% endraw %}{% endif %}{% raw %}

      - name: Helm install
        if: env.RUN_JOB == 'true'
        run: |
          helm upgrade --install e2e ./deployment/helm \
            --namespace app \
            --set image.frontend={% endraw %}{{ frontend_image_name }}{% raw %}:local \
            --set image.backend={% endraw %}{{ backend_image_name }}{% raw %}:local \
            --set image.pullPolicy=Never \
            --set env.frontend.BACKEND_HOST=$RUNNER_IP

      - name: Install latest versions of node packages
        if: false # skip until we're ready to do real E2E tests that require it, to save time in CI runs for now
        uses: ./.github/actions/install_deps
        with:
          node-version: {% endraw %}{{ node_version }}{% raw %}

      - name: Wait for rollout
        if: env.RUN_JOB == 'true'
        id: rollout
        run: kubectl -n app rollout status deploy/e2e-{% endraw %}{{ repo_name }}{% raw %} --timeout=180s

      - name: Diagnose rollout failure
        if: ${{ failure() && steps.rollout.outcome == 'failure' }}
        run: kubectl -n app get pods -o wide
      - name: Diagnose rollout failure - pod details
        if: ${{ failure() && steps.rollout.outcome == 'failure' }}
        run: kubectl -n app describe pods
      - name: Diagnose rollout failure - events
        if: ${{ failure() && steps.rollout.outcome == 'failure' }}
        run: kubectl -n app get events --sort-by=.lastTimestamp
      - name: Diagnose rollout failure - logs
        if: ${{ failure() && steps.rollout.outcome == 'failure' }}
        run: kubectl -n app logs deploy/e2e-{% endraw %}{{ repo_name }}{% raw %} --all-containers --tail=100 --ignore-errors || true

      - name: E2E Test # TODO: add more than just smoke test
        if: env.RUN_JOB == 'true'
        run: |
          # since there's no gap after the rollout to install node dependencies, sometimes the NodePorts themselves aren't ready yet, so do a few retries
          curl -s --show-error --fail-with-body --retry 10 --retry-delay 2 --retry-connrefused --retry-all-errors http://localhost:{% endraw %}{{ backend_nodeport_number }}{% raw %}/api/healthcheck
          curl -s --show-error --fail-with-body --retry 10 --retry-delay 2 --retry-connrefused --retry-all-errors http://localhost:{% endraw %}{{ frontend_nodeport_number }}{% raw %}/api/healthcheck
          curl -s --show-error --fail-with-body --retry 10 --retry-delay 2 --retry-connrefused --retry-all-errors http://localhost:{% endraw %}{{ frontend_nodeport_number }}{% raw %}/{% endraw %}{% endif %}{% raw %}{% endraw %}{% if run_backend_e2e_in_ci %}{% raw %}

  e2e-test-backend:
    name: End-to-end Testing of the Backend${{ (fromJSON(needs.changes.outputs.classes).code && fromJSON(needs.changes.outputs.classes).backend) != true && ' (skipped, no backend code changes)' || '' }}
    timeout-minutes: {% endraw %}{{ gha_xlong_timeout_minutes }}{% raw %}
    strategy:
      matrix:
        os:
          - "{% endraw %}{{ gha_linux_runner }}{% raw %}"
    runs-on: ${{ matrix.os }}
    needs:
      - build-backend
      - check-skip-duplicate
      - changes
    if: needs.check-skip-duplicate.outputs.should-run == 'true'
    env:
      RUN_JOB: ${{ fromJSON(needs.changes.outputs.classes).code && fromJSON(needs.changes.outputs.classes).backend }}
    steps:
      - name: Checkout code
        if: env.RUN_JOB == 'true'
        uses: actions/checkout@{% endraw %}{{ gha_checkout }}{% raw %}

      - name: Install latest versions of python packages
        if: env.RUN_JOB == 'true'
        uses: ./.github/actions/install_deps
        with:
          python-version: {% endraw %}{{ python_version }}{% raw %}
          skip-installing-ssm-plugin-manager: true

      - name: Download Backend Artifact
        if: env.RUN_JOB == 'true'
        uses: actions/download-artifact@{% endraw %}{{ gha_download_artifact }}{% raw %}
        with:
          name: ${{ needs.build-backend.outputs.artifact-name }}
          path: deployment-package-folder

      - name: Load docker images
        if: env.RUN_JOB == 'true'
        run: |
          ls deployment-package-folder -a
          # load all images in the folder
          ls -1 deployment-package-folder/*.tar | xargs --no-run-if-empty -L 1 docker load -i

      - name: Retag loaded backend image to stable local name
        if: env.RUN_JOB == 'true'
        run: docker tag ${{ needs.build-backend.outputs.full-image-tag }} {% endraw %}{{ backend_image_name }}{% raw %}:local{% endraw %}{% if auth_to_ecr_for_backend_e2e_in_ci %}{% raw %}

      - name: ECR Auth to pull images for E2E tests
        if: env.RUN_JOB == 'true'
        uses: ./.github/actions/ecr-auth
        with:
          aws-region: {% endraw %}{{ auth_to_ecr_for_backend_e2e_in_ci_region }}{% raw %}
          role-arn: {% endraw %}{{ auth_to_ecr_for_backend_e2e_in_ci_role_arn }}{% raw %}{% endraw %}{% endif %}{% raw %}

      - name: E2E test
        if: env.RUN_JOB == 'true'
        run: uv --directory=backend run pytest tests/e2e --durations=5{% endraw %}{% endif %}{% raw %}{% endraw %}{% if install_as_windows_service %}{% raw %}

  e2e-test-windows-service:
    name: Windows Service Smoke Tests${{ (fromJSON(needs.changes.outputs.classes).code && fromJSON(needs.changes.outputs.classes).backend) != true && ' (skipped, no backend code changes)' || '' }}
    timeout-minutes: {% endraw %}{{ gha_long_timeout_minutes }}{% raw %}
    runs-on: {% endraw %}{{ gha_windows_runner }}{% raw %}
    needs:
      - build-backend
      - check-skip-duplicate
      - changes
    if: needs.check-skip-duplicate.outputs.should-run == 'true'
    env:
      RUN_JOB: ${{ fromJSON(needs.changes.outputs.classes).code && fromJSON(needs.changes.outputs.classes).backend }}
    steps:
      - name: Allow long file paths
        if: env.RUN_JOB == 'true' && runner.os == 'Windows'
        # Some tooling (e.g. vcrpy, syrupy) generates file names past the 260 character limit Windows
        # defaults to. This has to happen before the checkout that writes those files.
        run: git config --global core.longpaths true

      - name: Checkout code
        if: env.RUN_JOB == 'true'
        uses: actions/checkout@{% endraw %}{{ gha_checkout }}{% raw %}

      - name: Install latest versions of python packages
        if: env.RUN_JOB == 'true'
        uses: ./.github/actions/install_deps
        with:
          python-version: {% endraw %}{{ python_version }}{% raw %}
          skip-installing-ssm-plugin-manager: true

      - name: Download Built executable
        if: env.RUN_JOB == 'true'
        uses: actions/download-artifact@{% endraw %}{{ gha_download_artifact }}{% raw %}
        with:
          name: built-{% endraw %}{{ repo_name }}{% raw %}-{% endraw %}{{ gha_windows_runner }}{% raw %}
          path: backend/dist/{% endraw %}{{ repo_name }}{% raw %}

      - name: Windows service smoke tests
        if: env.RUN_JOB == 'true'
        run: uv --directory=backend run pytest tests/windows_service --durations=5 --basetemp=dist/pytest-tmp

      - name: Dump service crash logs on failure
        if: ${{ failure() }}
        shell: pwsh
        run: |
          $dumps = Get-ChildItem -Path "backend/dist/pytest-tmp" -Recurse -Filter "service-crash.log" -ErrorAction SilentlyContinue
          if ($dumps.Count -eq 0) {
            Write-Host "No service-crash.log files found under backend/dist/pytest-tmp"
          } else {
            foreach ($dump in $dumps) {
              Write-Host "=== $($dump.FullName) ==="
              Get-Content $dump.FullName
            }
          }

      - name: Upload service logs on failure
        if: ${{ failure() }}
        uses: actions/upload-artifact@{% endraw %}{{ gha_upload_artifact }}{% raw %}
        with:
          name: windows-service-logs
          path: backend/dist/pytest-tmp/**/service-logs/**
          if-no-files-found: warn
          retention-days: 5

