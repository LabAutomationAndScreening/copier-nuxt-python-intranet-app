# Path classes for the `changes` job in .github/workflows/ci.yaml. Every top-level key becomes a boolean in that job's
# `classes` output, read as fromJSON(needs.changes.outputs.classes).<key>, true when the change touched a matching
# path. Globs follow dorny/paths-filter (picomatch); a leading `!` excludes.
#
# `code` is every path a build, test or packaging job may depend on, so exclude only paths no such job reads. A code
# path that no other class claims switches every class on, which means an unlisted path can never cause a job to be
# skipped. A project that builds its documentation excludes the sources here and claims them in a class of its own
# that gates the docs job. Project classes go below `code`.
code:
  - '**'
  - '!**/*.md'
  - '!.coderabbit.yaml'
  - '!**/*.mmd'
  - '!*.code-workspace'
  - '!.github/ISSUE_TEMPLATE/**'
  - '!LICENSE'
  # unit-level tests never reach a build artifact; their own classes still run them{% if has_backend %}
  - '!backend/tests/unit/**'{% endif %}
  - '!frontend/tests/unit/**'
  - '!frontend/tests/compiled/**'
frontend:
  - 'frontend/**'
  - 'pnpm-lock.yaml'
  - 'pnpm-workspace.yaml'{% if has_backend %}
  - 'backend/tests/unit/__snapshots__/test_basic_server_functionality/test_openapi_schema.json'{% if frontend_uses_graphql %}
  - 'backend/src/backend_api/graphql/schema.graphql'{% endif %}
backend:
  - 'backend/**'
  - 'pytest.ini'{% endif %}{% if install_as_windows_service %}
installer:
  - 'installer/**'
  - '!installer/**/*.md'{% endif %}
