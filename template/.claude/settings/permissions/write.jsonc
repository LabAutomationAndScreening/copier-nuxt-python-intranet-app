/*
 * ============== WARNING ==============================================================================
 * File is managed by copier template: gh:LabAutomationAndScreening/copier-base-template.git
 * See .config/.copier-managed-files.json for details.
 *
 * You are welcome to make changes to this file in your repo if they are custom to your project,
 * but if the change should be shared with other projects, please backport it to the template repo.
 * =====================================================================================================
 */
{
  // Write permissions for specific files
  // This should only ever be running in a devcontainer, so pretty lenient permissions are allowed
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Write(/tmp/**/*)", "Write(/workspaces/**/tmp/**)", "Write(tmp/**)"],
    // Taskfiles decide what `Bash(task *)` actually executes, so a change to one deserves a look even though the
    // rest of the repo is written freely in a devcontainer. `ask` outranks `allow`, so these survive a future
    // broad write allow. This only covers the file-editing tools: Claude Code does not parse bash command text
    // for paths, so a `sed -i` against a taskfile still goes through unprompted, and review of the diff is what
    // catches that.
    "ask": [
      "Write(Taskfile.yaml)",
      "Write(.config/taskfiles/**)",
      "Edit(Taskfile.yaml)",
      "Edit(.config/taskfiles/**)",
    ],
  },
}
