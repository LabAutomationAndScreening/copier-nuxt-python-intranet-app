test.describe("API routing", () => {
  // When the built executable serves the frontend, its static folder includes the frontend's 404.html,
  // so this guards against an unknown API path falling through to the frontend's HTML not-found page.
  test("When unknown path under /api/ requested, Then 404 problem details returned instead of the frontend", async ({
    request,
  }) => {
    const unknownPath = `/api/${faker.string.uuid()}`;

    const response = await request.get(`${backendBaseUrl()}${unknownPath}`);

    expect(response.status()).toBe(404);
    expect(response.headers()["content-type"]).toBe("application/problem+json");
  });
});

interface ObservedContainerExit {
  response: APIResponse;
  exitCodes: string[];
  logs: string;
}

async function callRouteAndObserveContainerExit({
  request,
  route,
}: {
  request: APIRequestContext;
  route: string;
}): Promise<ObservedContainerExit> {
  const containerId = composeServiceContainerId({ composeFile: dockerComposeFile, service: "backend" });
  const previousRestartCount = containerRestartCount({ containerId });
  const requestedAt = new Date().toISOString();

  const response = await request.post(`${backendBaseUrl()}${route}`);

  // the compose file uses restart: unless-stopped, so Docker brings the backend back after either exit code;
  // waiting for it to be healthy again also leaves the shared backend usable by the specs that run after this one
  await waitForContainerRestart({ containerId, previousRestartCount });
  await waitForComposeHealthy({ composeFile: dockerComposeFile });
  return {
    response,
    exitCodes: containerExitCodesSince({ containerId, since: requestedAt }),
    logs: containerLogsSince({ containerId, since: requestedAt }),
  };
}

// These call the API directly rather than through the browser: there is no UI for them, and this suite is
// what runs against the real deployed backend (container or built executable) in CI for every template variant.
test.describe("Given the backend running under docker-compose", () => {
  test.skip(!isDockerComposeE2E, "observes the backend container's exit and restart through Docker");

  test("When restart route called, Then container exits with code 1 after graceful shutdown and is restarted", async ({
    request,
  }) => {
    test.slow(); // waits for the container to exit, be restarted by Docker, and become healthy again

    const observed = await callRouteAndObserveContainerExit({ request, route: "/api/restart" });

    expect(observed.response.ok()).toBe(true);
    expect(observed.exitCodes).toEqual(["1"]);
    expect(observed.logs).toContain("Application shutdown complete.");
  });

  test("When shutdown route called, Then container exits with code 0 after graceful shutdown", async ({ request }) => {
    test.slow(); // waits for the container to exit, be restarted by Docker, and become healthy again

    const observed = await callRouteAndObserveContainerExit({ request, route: "/api/shutdown" });

    expect(observed.response.ok()).toBe(true);
    expect(observed.exitCodes).toEqual(["0"]);
    expect(observed.logs).toContain("Application shutdown complete.");
  });
});

interface ObservedProcessExit {
  response: APIResponse;
  exitCode: number | null;
  output: string;
}

async function callRouteAndObserveProcessExit({
  request,
  route,
}: {
  request: APIRequestContext;
  route: string;
}): Promise<ObservedProcessExit> {
  const backend = await startSeparateBuiltBackend({ port: await getRandomOpenPort() });
  try {
    const response = await request.post(`${backend.baseUrl}${route}`);
    const exitCode = await backend.exited;
    return { response, exitCode, output: backend.output() };
  } finally {
    backend.stop();
  }
}

test.describe("Given the backend running as a built executable", () => {
  test.skip(!isBuiltBackendE2E, "starts its own instance of the built executable and observes its exit code");

  test("When restart route called, Then process exits with code 1 after graceful shutdown", async ({ request }) => {
    test.slow(); // starts a second backend process and waits for it to exit

    const observed = await callRouteAndObserveProcessExit({ request, route: "/api/restart" });

    expect(observed.response.ok()).toBe(true);
    expect(observed.exitCode).toBe(1);
    expect(observed.output).toContain("Application shutdown complete.");
  });

  test("When shutdown route called, Then process exits with code 0 after graceful shutdown", async ({ request }) => {
    test.slow(); // starts a second backend process and waits for it to exit

    const observed = await callRouteAndObserveProcessExit({ request, route: "/api/shutdown" });

    expect(observed.response.ok()).toBe(true);
    expect(observed.exitCode).toBe(0);
    expect(observed.output).toContain("Application shutdown complete.");
  });
});{% endraw %}
