{% if has_backend %}{% raw %}# ------------ Stage 0: Backend API client ------------
# The client is not committed, so the image generates it from the committed OpenAPI snapshot. Same Kiota version and
# flags as gen-frontend-openapi-client in .config/taskfiles/codegen.yaml: change both together.
FROM mcr.microsoft.com/openapi/kiota:{% endraw %}{{ kiota_cli_version }}{% raw %} AS api-client

ENV KIOTA_OFFLINE_ENABLED=true \
    KIOTA_CLI_TELEMETRY_OPTOUT=true

# repo-root is a named --build-context, not a FROM alias, so DL3022 doesn't apply here
# hadolint ignore=DL3022
COPY --from=repo-root backend/tests/unit/__snapshots__/test_basic_server_functionality/test_openapi_schema.json /app/openapi.json

# The image has no shell, so RUN takes the exec form, and its entrypoint runs kiota.dll from /app, so the working
# directory stays /app.
RUN ["dotnet", "kiota.dll", "generate", "-l", "typescript", "-c", "BackendClient", "-n", "client", "-d", "openapi.json", "--exclude-backward-compatible", "--clean-output", "--additional-data", "false", "-o", "generated"]

{% endraw %}{% endif %}{% raw %}# ------------ Stage 1: Build ------------
FROM node:{% endraw %}{{ node_version }}{% raw %}-{% endraw %}{{ debian_release_name }}{% raw %} AS builder

# docker build --build-context repo-root=.. -t my-nuxt-app .
# docker run --rm -p {% endraw %}{{ frontend_deployed_port_number }}{% raw %}:3000 my-nuxt-app

# Install pnpm globally
RUN npm install -g pnpm@{% endraw %}{{ pnpm_version }}{% raw %}

WORKDIR /app

# Skip Playwright browser install in Docker builds (not needed for static generate)
ENV INSTALL_PLAYWRIGHT_BROWSERS=0

# Mirror repo workspace structure: root files at /app, frontend source at /app/frontend
# First just copy in the dependency information for better caching
# repo-root is a named --build-context, not a FROM alias, so DL3022 doesn't apply here
# hadolint ignore=DL3022
COPY --from=repo-root pnpm-workspace.yaml pnpm-lock.yaml ./
COPY package.json ./frontend/
COPY scripts/postinstall.mjs ./frontend/scripts/postinstall.mjs

# Install dependencies from workspace root
RUN pnpm ci

COPY . ./frontend/
{% endraw %}{% if has_backend %}{% raw %}
COPY --from=api-client /app/generated ./frontend/app/generated/open-api/backend
# the fixer reads the snapshot from where it sits in the repo, relative to the fixer itself
# hadolint ignore=DL3022
COPY --from=repo-root backend/tests/unit/__snapshots__/test_basic_server_functionality/test_openapi_schema.json ./backend/tests/unit/__snapshots__/test_basic_server_functionality/test_openapi_schema.json
RUN python3 frontend/kiota_nullable_fixer.py
{% endraw %}{% endif %}{% raw %}
# build the Nuxt app (generates .output folder in Nuxt 4)
RUN pnpm list && pnpm --filter ./frontend generate

# ------------ Stage 2: Production ------------
FROM nginx:{% endraw %}{{ nginx_image_version }}{% raw %}-alpine{% endraw %}{{ alpine_image_version }}{% raw %}-slim AS production

# bring in envsubst (part of gettext) (no particular reason for this version, just pinning for best practice), and take
# the newest trust store at build time instead of the one frozen into the base image
RUN apk add --no-cache gettext~=0.24.1 "ca-certificates>=20261020-r0"
COPY default.conf.template /etc/nginx/conf.d/default.conf.template
COPY --from=builder /app/frontend/.output/public /usr/share/nginx/html

# set sensible defaults (overridable at `docker run`)
ENV BACKEND_HOST=host.docker.internal \
    BACKEND_PORT={% endraw %}{{ backend_deployed_port_number }}{% raw %} \
    FRONTEND_PORT={% endraw %}{{ frontend_deployed_port_number }}{% raw %}

# Using port 80 caused problems running K8s on windows hosts, so using a higher port number
EXPOSE {% endraw %}{{ frontend_deployed_port_number }}{% raw %}

HEALTHCHECK --interval=5s --timeout=1s --retries=20 --start-period=10s \
  CMD ["sh", "-c", "wget -q -O /dev/null http://127.0.0.1:${FRONTEND_PORT}/ || exit 1"]

# Dynamically adjust the NGINX config based on the environmental variables, create a txt version that's easily viewable in client browsers, then start Nginx in foreground
CMD ["sh", "-c", "envsubst '$BACKEND_HOST $BACKEND_PORT $FRONTEND_PORT' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && ln -sf /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf.txt && exec nginx -g 'daemon off;'"]{% endraw %}
